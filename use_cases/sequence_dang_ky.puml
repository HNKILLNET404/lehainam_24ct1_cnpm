@startuml
skinparam sequenceMessageAlign center
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 11

actor "Khách hàng" as User
participant "[Giao diện]\nD:/urban-threads/templates/accounts/register.html" as UI
participant "[Xử lý nghiệp vụ]\nD:/urban-threads/accounts/views.py" as BE
database "[Cơ sở dữ liệu]\nD:/urban-threads/db.sqlite3\n(Bảng: accounts_user)" as DB

box "Tên chức năng: Đăng ký tài khoản" #LightYellow
end box

User -> UI : 1. Yêu cầu truy cập chức năng đăng ký
activate UI
UI --> User : 2. Hiển thị form đăng ký (Email, Họ và tên, SĐT, Password, Nhập lại password)
deactivate UI

User -> UI : 3. Nhập thông tin (email, họ và tên, phone, password, nhập lại password)
activate UI
UI -> BE : 4. Gửi dữ liệu form đăng ký (POST)
activate BE

BE -> DB : 5. Truy vấn kiểm tra email đã tồn tại trong CSDL chưa?
activate DB
DB --> BE : 6. Trả về kết quả kiểm tra
deactivate DB

alt Điều kiện: Email chưa tồn tại & Password trùng khớp
    BE -> BE : 7. Băm mật khẩu bảo mật (PBKDF2_SHA256)
    BE -> DB : 8. Lưu tài khoản mới vào bảng accounts_user
    activate DB
    DB --> BE : 9. Trả về kết quả lưu thành công
    deactivate DB
    BE --> UI : 10. Trả về thông báo "Đăng ký thành công"
    deactivate BE
    activate UI
    UI --> User : 11. Chuyển hướng sang trang đăng nhập (/accounts/login/)
    deactivate UI
else Điều kiện: Email đã tồn tại HOẶC Password không trùng khớp
    activate BE
    BE --> UI : 7*. Trả về thông báo lỗi cụ thể
    deactivate BE
    activate UI
    UI --> User : 8*. Hiển thị lỗi trên form đăng ký để người dùng sửa lại
    deactivate UI
end

@enduml
