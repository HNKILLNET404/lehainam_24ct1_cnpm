SECRET_KEY=django-insecure-urban-threads-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (SQLite for dev)
DATABASE_URL=sqlite:///db.sqlite3

# Email (dùng console backend cho dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Media
MEDIA_URL=/media/
MEDIA_ROOT=media

# QR Payment Bank Info (Thay đổi sang bất kỳ ngân hàng nào tùy thích)
# Một số mã ngân hàng phổ biến (BANK_ID):
# - Vietcombank: VCB (hoặc 970436)
# - Techcombank: TCB (hoặc 970407)
# - MB Bank: MB (hoặc 970422)
# - ACB: ACB (hoặc 970416)
# - BIDV: BIDV (hoặc 970418)
# - VietinBank: CTG (hoặc 970415)
# - TPBank: TPB (hoặc 970423)
# - VPBank: VPB (hoặc 970432)
# - Agribank: VBA (hoặc 970405)
BANK_ID=VCB
BANK_NAME=Vietcombank (Ngân hàng Ngoại thương VN)
BANK_ACCOUNT_NO=1023456789
BANK_ACCOUNT_NAME=NGUYEN VAN A
BANK_TEMPLATE=compact

# Free shipping threshold (VND)
FREE_SHIPPING_THRESHOLD=500000
