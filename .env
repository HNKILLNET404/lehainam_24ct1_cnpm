SECRET_KEY=django-insecure-urban-threads-secret-key-change-in-production-2026
DEBUG=True
ALLOWED_HOSTS=*

# Database (SQLite for dev)
DATABASE_URL=sqlite:///urban_threads.sqlite3

# Email (dùng console backend cho dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# Media
MEDIA_URL=/media/
MEDIA_ROOT=media

# QR Payment Bank Info
BANK_ID=VCB
BANK_NAME=Vietcombank (Ngân hàng Ngoại thương VN)
BANK_ACCOUNT_NO=1019223762
BANK_ACCOUNT_NAME=LE HAI NAM
BANK_TEMPLATE=compact

# Free shipping threshold (VND)
FREE_SHIPPING_THRESHOLD=500000
